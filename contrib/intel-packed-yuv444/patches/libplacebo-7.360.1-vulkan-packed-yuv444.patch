+struct pl_drm_packed_yuv_layout {
+    const char *format;
+    int depth;
+    int component_mapping[4];
+};
+
+static bool pl_get_drm_packed_yuv_layout(uint32_t fourcc,
+                                        struct pl_drm_packed_yuv_layout *layout)
+{
+    switch (fourcc) {
+    case MKTAG('X', 'Y', 'U', 'V'):
+        // XYUV8888 stores Cr, Cb, Y, X from low to high byte. Sampling it
+        // as BGRA8 exposes Y, Cb, Cr without performing RGB conversion.
+        // The component map follows host storage order; the renderer also
+        // applies BGRA8's sample_order when assigning the sampled channels.
+        *layout = (struct pl_drm_packed_yuv_layout) {
+            .format = "bgra8", .depth = 8,
+            .component_mapping = {2, 1, 0, PL_CHANNEL_NONE},
+        };
+        return true;
+    case MKTAG('Y', '4', '1', '0'):
+    case MKTAG('X', 'V', '3', '0'):
+        // Y410/XVYU2101010 has Cb, Y, Cr in the low three 10-bit fields.
+        // RGB10A2 preserves those fields; the last two bits are ignored.
+        *layout = (struct pl_drm_packed_yuv_layout) {
+            .format = "rgb10a2", .depth = 10,
+            .component_mapping = {1, 0, 2, PL_CHANNEL_NONE},
+        };
+        return true;
+    default:
+        return false;
+    }
+}
